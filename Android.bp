package {
    default_applicable_licenses: ["external_wireless-regdb_license"],
}

license {
    name: "external_wireless-regdb_license",
    visibility: [
        ":__subpackages__",
        "//device/google/desktop:__subpackages__",
    ],
    license_kinds: [
        "SPDX-license-identifier-ISC",
    ],
    license_text: [
        "LICENSE",
    ],
}

genrule {
    name: "wireless-regdb-generate",
    srcs: [
        "db.txt",
        "db2fw.py",
        "dbparse.py",
    ],
    out: ["regulatory.db"],
    cmd: "$(location db2fw.py) $(out) $(location db.txt)",
}

filegroup {
    name: "wireless-regdb-prebuilts",
    srcs: [
        "regulatory.db",
        "regulatory.db.p7s",
    ],
}
